# VÉRRA Backend Environment Configuration
# Copy this file to .env and provide your MongoDB Atlas credentials:

PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/verra_bi?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/verra_bi
DB_NAME=verra_bi

# JWT Secret Key for Authentication
JWT_SECRET=verra_luxury_secret_jwt_key_2026_botanical
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Use * or http://127.0.0.1:5500, https://username.github.io)
FRONTEND_ORIGIN=*
